# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: your Fortify SCA access token
FORTIFY_SCA_ACCESS_TOKEN=your_token_here

# Optional: override if using a custom Fortify SCA base URL
# FORTIFY_SCA_BASE_URL=https://debricked.com

# Optional: Fortify SCA API version (default: 1.0)
# FORTIFY_SCA_API_VERSION=1.0

# Optional: MCP transport (this Go build supports only stdio)
# MCP_TRANSPORT=stdio
